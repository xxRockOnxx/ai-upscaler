REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=abc
MINIO_SECRET_KEY=def

# Optional. Set to `true` if your MINIO server needs it
# MINIO_USE_SSL=false

REAL_ESRGAN_PATH=./realesrgan/realesrgan-ncnn-vulkan
WAIFU2X_PATH=./waifu2x/waifu2x-ncnn-vulkan

# Anime4K is applied by ffmpeg's libplacebo filter — this points at the
# combined GLSL shader chain, not a binary. Build it by downloading
# https://github.com/bloc97/Anime4K/releases/download/v4.0.1/Anime4K_v4.0.zip
# and concatenating (Mode A, 4x): Clamp_Highlights + Restore_CNN_VL +
# Upscale_CNN_x2_VL + Restore_CNN_M + Upscale_CNN_x2_M.
# Your ffmpeg must be built with --enable-libplacebo (arch/homebrew builds are).
ANIME4K_PATH=./anime4k/anime4k-mode-a-4x.glsl

RIFE_PATH=./rife/rife-ncnn-vulkan

# Optional. fluent-ffmpeg picks these up automatically; when unset it falls
# back to `ffmpeg`/`ffprobe` on your $PATH. The Docker image sets them to its
# bundled minimal build.
# FFMPEG_PATH=/app/ffmpeg/ffmpeg
# FFPROBE_PATH=/app/ffmpeg/ffprobe
